---
import { entryPath, formatDate } from '../lib/urls';
interface Props { collection: 'writing' | 'projects' | 'videos'; entry: { data: { slug: string; title: string; summary: string; language?: 'en' | 'ml'; type?: string; tags?: string[]; technologies?: string[]; status?: string; published?: Date } }; }
const { entry: { data }, collection } = Astro.props;
---
<article class:list={['entry', { 'project-entry': collection === 'projects' }]} lang={data.language || 'en'}>
  <div class="meta"><span class="tag">{data.type?.replace('-', ' ') || (collection === 'projects' ? 'Project' : 'Video')}</span>{data.status && <span>{data.status === 'completed' ? 'Released' : data.status}</span>}{data.published && <time datetime={data.published.toISOString()}>{formatDate(data.published, data.language)}</time>}{data.language && <span lang={data.language}>{data.language === 'ml' ? 'മലയാളം' : 'English'}</span>}</div>
  <h3><a href={entryPath(collection, data.slug)}>{data.title}</a></h3>
  <p>{data.summary}</p>
  {collection === 'projects' && <><div class="tag-list">{data.technologies?.slice(0, 4).map((tag) => <span>{tag}</span>)}</div><span class="project-arrow" aria-hidden="true">↗</span></>}
  {data.tags && data.tags.length > 0 && <div class="tag-list">{data.tags.map((tag) => <span>{tag}</span>)}</div>}
</article>
