---
import { render } from 'astro:content';
import Shell from '../../layouts/Shell.astro';
import ReaderTools from '../../components/ReaderTools.astro';
import Related from '../../components/Related.astro';
import { catalog, readingTime, relatedEntries } from '../../lib/content';
import { entryPath, pathFor, formatDate, assetUrl } from '../../lib/urls';
export async function getStaticPaths() { return (await catalog()).writing.map((entry) => ({ params: { slug: entry.data.slug }, props: { entry } })); }
const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const data = entry.data;
const all = await catalog();
const translation = all.writing.find((item) => item.data.slug === data.translation);
const series = data.series ? all.writing.filter((item) => item.data.series?.name === data.series!.name && item.data.language === data.language).sort((a, b) => a.data.series!.order - b.data.series!.order) : [];
const index = series.findIndex((item) => item.id === entry.id);
const toc = headings.filter((heading) => heading.depth === 2);
const related = relatedEntries(all, data.related);
---
<Shell title={data.title} description={data.summary} language={data.language} article published={data.published} updated={data.updated} translation={translation?.data.slug}>
  <header class="page-head"><p class="eyebrow" lang="en"><a href={pathFor('/writing/')}>← The notebook</a> · {data.type.replace('-', ' ')}</p><h1>{data.title}</h1><p class="summary">{data.summary}</p><div class="meta"><span>{data.language === 'ml' ? 'മലയാളം' : 'English'}</span><time datetime={data.published!.toISOString()}>{formatDate(data.published, data.language)}</time><span>{readingTime(entry.body || '', data.language)} {data.language === 'ml' ? 'മിനിറ്റ് വായന' : 'min read (estimate)'}</span></div>{data.updated && <p class="meta">{data.language === 'ml' ? 'പുതുക്കിയത്' : 'Updated'} <time datetime={data.updated.toISOString()}>{formatDate(data.updated, data.language)}</time></p>}<div class="tag-list">{data.tags.map((tag) => <span>{tag}</span>)}</div>{translation && <p class="link-row"><a href={entryPath('writing', translation.data.slug)} lang={translation.data.language} hreflang={translation.data.language}>{translation.data.language === 'ml' ? 'മലയാളത്തിൽ വായിക്കുക →' : 'Read in English →'}</a></p>}</header>
  {data.image && <figure style="margin-bottom:30px"><img src={assetUrl(data.image.src)} alt={data.image.alt} /></figure>}
  {toc.length >= 3 && <details class="toc" open><summary>{data.language === 'ml' ? 'ഈ കുറിപ്പിൽ' : 'In this entry'}</summary><ol>{toc.map((heading) => <li><a href={`#${heading.slug}`}>{heading.text}</a></li>)}</ol></details>}
  <article class="prose"><Content /></article>
  {data.series && <section class="section"><p class="meta">{data.series.name} · {data.language === 'ml' ? 'ഭാഗം' : 'Part'} {data.series.order}</p><nav class="series-nav" aria-label="Guide series">{index > 0 && <a href={entryPath('writing', series[index - 1].data.slug)}>← {series[index - 1].data.title}</a>}{index < series.length - 1 && <a href={entryPath('writing', series[index + 1].data.slug)}>{series[index + 1].data.title} →</a>}</nav></section>}
  <Related entries={related} /><ReaderTools />
</Shell>
