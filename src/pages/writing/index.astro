---
import Shell from '../../layouts/Shell.astro';
import Entry from '../../components/Entry.astro';
import { catalog } from '../../lib/content';
import { pathFor, formatDate } from '../../lib/urls';
import { site } from '../../config/site';
const { writing, external } = await catalog();
const topics = [...new Set(writing.flatMap((entry) => entry.data.tags))].sort();
const types = [...new Set(writing.map((entry) => entry.data.type))].sort();
---
<Shell title="Writing" description="Explanations, short notes, project write-ups, and reading notes in English and Malayalam.">
  <header class="page-head"><p class="eyebrow">From the notebook</p><h1>Writing.</h1><p class="summary">Notes on engineering with AI, learning through projects, and making time for what matters.</p></header>
  {writing.length > 0 && <><form class="archive-filters" id="filters" role="search" aria-label="Search writing">
    <label class="search-field">Search the notebook<input id="search" name="q" type="search" placeholder="A topic, title, or question…" /></label>
    <label>Language<select name="language" id="language"><option value="">All languages</option><option value="en">English</option><option value="ml">മലയാളം</option></select></label>
    <label>Type<select name="type" id="type"><option value="">All types</option>{types.map((type) => <option value={type}>{type.replace('-', ' ')}</option>)}</select></label>
    <label>Topic<select name="topic" id="topic"><option value="">All topics</option>{topics.map((topic) => <option value={topic}>{topic}</option>)}</select></label>
    <button class="filter-reset" type="reset">Clear filters</button>
  </form>
  <p class="results-count" id="results-count" role="status" aria-live="polite">{writing.length} published {writing.length === 1 ? 'entry' : 'entries'}</p>
  <div id="entries">{writing.map((entry) => <div data-entry data-search={`${entry.data.title} ${entry.data.summary} ${entry.data.tags.join(' ')} ${entry.body || ''}`.normalize('NFC').toLowerCase()} data-language={entry.data.language} data-type={entry.data.type} data-tags={JSON.stringify(entry.data.tags)}><Entry collection="writing" entry={entry} headingLevel={2} /></div>)}</div>
  <div class="empty-note" id="empty-results" hidden><h2>No matching entries.</h2><p>Try a different word, language, or topic—or clear the filters.</p></div>
  <noscript><p>All published entries are listed above. Enable JavaScript to filter this archive.</p></noscript></>}
  {!writing.length && <><div class="empty-note"><h2>No writing published yet.</h2><p>I’m shaping this notebook around questions fellow CS students face. I plan to write in English and Malayalam.</p><div class="link-row"><a href={pathFor('/projects/')}>Explore the projects →</a><a href={pathFor('/contact/')}>Suggest a question →</a><a href={pathFor('/rss.xml')}>Follow with RSS →</a></div></div><section class="section"><h2>What I want to explore</h2><ul class="theme-list">{site.themes.map((theme) => <li><h3>{theme.title}</h3><p>{theme.summary}</p></li>)}</ul></section></>}
  {external.length > 0 && <section class="section"><h2>Elsewhere on the web</h2><p class="results-count">Selected external publications; separate from this notebook’s search.</p>{external.map((entry) => <article class="entry" lang={entry.data.language}><div class="meta">{entry.data.platform} · {formatDate(entry.data.published, entry.data.language)}</div><h3><a href={entry.data.url}>{entry.data.title} ↗</a></h3><p>{entry.data.summary}</p></article>)}</section>}
  <script>
    const form = document.querySelector<HTMLFormElement>('#filters');
    if (form) {
    const fields = ['q', 'language', 'type', 'topic'] as const;
    const controls = fields.map((name) => form.elements.namedItem(name) as HTMLInputElement | HTMLSelectElement);
    const entries = [...document.querySelectorAll<HTMLElement>('[data-entry]')];
    function apply(writeUrl = true) {
      const [q, language, type, topic] = controls.map((control) => control.value.normalize('NFC').trim());
      let count = 0;
      for (const entry of entries) { const match = q.toLowerCase().split(/\s+/).every((word) => entry.dataset.search!.includes(word)) && (!language || entry.dataset.language === language) && (!type || entry.dataset.type === type) && (!topic || JSON.parse(entry.dataset.tags!).includes(topic)); entry.hidden = !match; if (match) count++; }
      document.querySelector('#results-count')!.textContent = `${count} ${count === 1 ? 'entry' : 'entries'}${q || language || type || topic ? ' found' : ' published'}`;
      (document.querySelector('#empty-results') as HTMLElement).hidden = count > 0;
      if (writeUrl) { const url = new URL(location.href); controls.forEach((control, index) => { control.value ? url.searchParams.set(fields[index], control.value) : url.searchParams.delete(fields[index]); }); history.replaceState(null, '', url); }
    }
    function readUrl() { const params = new URLSearchParams(location.search); controls.forEach((control, index) => { control.value = params.get(fields[index]) || ''; }); apply(false); }
    form.addEventListener('submit', (event) => { event.preventDefault(); apply(); }); form.addEventListener('input', () => apply()); form.addEventListener('change', () => apply());
    form.addEventListener('reset', () => { setTimeout(() => apply(), 0); }); window.addEventListener('popstate', readUrl); readUrl();
    }
  </script>
</Shell>
