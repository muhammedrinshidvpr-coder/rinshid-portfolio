---
import { render } from 'astro:content';
import Shell from '../layouts/Shell.astro';
import { catalog } from '../lib/content';
import { pathFor, formatDate } from '../lib/urls';
const update = (await catalog()).now[0];
const rendered = update ? await render(update) : null;
const Content = rendered?.Content;
---
<Shell title="Now" description="A manually maintained snapshot of what I’m working on and learning.">
  <header class="page-head"><p class="eyebrow">A snapshot, not a status feed</p><h1>On my desk.</h1><p class="summary">What I’m working on, learning, and making room for.</p>{update && <p class="meta">Last updated <time datetime={update.data.updated.toISOString()}>{formatDate(update.data.updated)}</time></p>}</header>
  {Content ? <article class="prose"><Content /></article> : <div class="empty-note"><h2>A current update is still to come.</h2><p>I haven’t written a dated Now update for this notebook yet. You can explore <a href={pathFor('/projects/')}>my public projects</a> or read <a href={pathFor('/about/')}>about my interests</a> in the meantime.</p></div>}
</Shell>
