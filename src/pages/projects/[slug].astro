---
import { render } from 'astro:content';
import Shell from '../../layouts/Shell.astro';
import Related from '../../components/Related.astro';
import ReaderTools from '../../components/ReaderTools.astro';
import { catalog, relatedEntries } from '../../lib/content';
import { pathFor, assetUrl } from '../../lib/urls';
export async function getStaticPaths() { return (await catalog()).projects.map((entry) => ({ params: { slug: entry.data.slug }, props: { entry } })); }
const { entry } = Astro.props;
const { Content } = await render(entry);
const data = entry.data;
const all = await catalog();
const related = relatedEntries(all, data.related);
for (const kind of ['writing', 'videos', 'external'] as const) for (const item of all[kind]) if (item.data.related.projects.includes(data.slug)) { const url = kind === 'external' ? ('url' in item.data ? item.data.url : '') : pathFor(`/${kind}/${item.data.slug}/`); if (!related.some((link) => link.url === url)) related.push({ title: item.data.title, url, kind, language: item.data.language }); }
---
<Shell title={data.title} description={data.summary}>
  <header class="page-head"><p class="eyebrow"><a href={pathFor('/projects/')}>← Projects</a></p><h1>{data.title}</h1><p class="summary">{data.summary}</p><div class="link-row">{data.source && <a href={data.source}>Explore the source ↗</a>}{data.demo && <a href={data.demo}>{data.demo.includes('/releases/') ? 'See releases & downloads' : 'Visit the project'} ↗</a>}</div></header>
  <dl class="facts"><div><dt>Status</dt><dd>{data.status === 'completed' ? 'Released' : data.status.charAt(0).toUpperCase() + data.status.slice(1)}</dd></div><div><dt>My contribution</dt><dd>{data.role}</dd></div><div><dt>Made for</dt><dd>{data.audience}</dd></div><div><dt>Built with</dt><dd>{data.technologies.join(' · ')}</dd></div></dl>
  <div class="prose"><h2>The problem</h2><p>{data.problem}</p><h2>What it does</h2><ul>{data.features.map((feature) => <li>{feature}</li>)}</ul><Content />{data.screenshots.map((image) => <figure><img src={assetUrl(image.src)} alt={image.alt} loading="lazy" /><figcaption>{image.alt}</figcaption></figure>)}{data.lessons.length > 0 && <><h2>Design takeaways</h2><ul>{data.lessons.map((lesson) => <li>{lesson}</li>)}</ul></>}<h2>Current limitations</h2><ul>{data.limitations.map((limit) => <li>{limit}</li>)}</ul></div>
  <Related entries={related} /><ReaderTools />
</Shell>
