---
import { render } from 'astro:content';
import Shell from '../../layouts/Shell.astro';
import ReaderTools from '../../components/ReaderTools.astro';
import Related from '../../components/Related.astro';
import { catalog, relatedEntries } from '../../lib/content';
import { pathFor, formatDate, assetUrl } from '../../lib/urls';
export async function getStaticPaths() { return (await catalog()).videos.map((entry) => ({ params: { slug: entry.data.slug }, props: { entry } })); }
const { entry } = Astro.props;
const data = entry.data;
const { Content } = await render(entry);
const source = new URL(data.source);
let embed = '';
if (data.provider === 'youtube' && ['www.youtube.com', 'youtube.com', 'youtu.be'].includes(source.hostname)) {
  const id = source.hostname === 'youtu.be' ? source.pathname.slice(1) : source.searchParams.get('v') || source.pathname.match(/^\/(?:shorts|embed)\/([^/]+)$/)?.[1];
  if (id && /^[a-zA-Z0-9_-]{11}$/.test(id)) embed = `https://www.youtube-nocookie.com/embed/${id}`;
} else if (data.provider === 'vimeo' && ['vimeo.com', 'www.vimeo.com'].includes(source.hostname) && /^\/\d+$/.test(source.pathname)) embed = `https://player.vimeo.com/video${source.pathname}`;
---
<Shell title={data.title} description={data.summary} language={data.language} published={data.published}>
  <header class="page-head"><p class="eyebrow" lang="en"><a href={pathFor('/videos/')}>← Videos</a></p><h1>{data.title}</h1><p class="summary">{data.summary}</p><div class="meta"><span>{data.language === 'ml' ? 'മലയാളം' : 'English'}</span><time datetime={data.published!.toISOString()}>{formatDate(data.published, data.language)}</time></div></header>
  {data.thumbnail && <img src={assetUrl(data.thumbnail.src)} alt={data.thumbnail.alt} loading="lazy" />}
  {embed && <div class="video-player" data-embed={embed} data-title={data.title}><button id="load-video" type="button">Load {data.provider === 'youtube' ? 'YouTube' : 'Vimeo'} player</button></div>}
  <p><a href={data.source}>Watch “{data.title}” on {data.provider === 'other' ? 'the original site' : data.provider} ↗</a></p>
  {embed && <p class="meta" lang="en">The player connects to {data.provider} only after you choose to load it.</p>}
  {entry.body?.trim() && <section class="section"><h2>{data.language === 'ml' ? 'വീഡിയോയുടെ എഴുത്തുരൂപം' : 'Transcript & notes'}</h2><label class="transcript-search" for="transcript-search">{data.language === 'ml' ? 'തിരയുക' : 'Find in transcript'}</label><input id="transcript-search" type="search" /><p id="transcript-count" class="meta" role="status" aria-live="polite"></p><article class="prose" id="transcript"><Content /></article></section>}
  <Related entries={relatedEntries(await catalog(), data.related)} /><ReaderTools />
  <script>
    document.querySelector('#load-video')?.addEventListener('click', () => { const host = document.querySelector<HTMLElement>('[data-embed]')!; const iframe = document.createElement('iframe'); iframe.src = host.dataset.embed!; iframe.title = host.dataset.title!; iframe.allow = 'fullscreen; picture-in-picture'; iframe.allowFullscreen = true; host.replaceChildren(iframe); });
    const search = document.querySelector<HTMLInputElement>('#transcript-search');
    search?.addEventListener('input', () => {
      const root = document.querySelector('#transcript')!;
      root.querySelectorAll('mark').forEach((mark) => mark.replaceWith(document.createTextNode(mark.textContent || ''))); root.normalize();
      const query = search.value.trim().normalize('NFC').toLowerCase(); let count = 0;
      if (query) {
        const walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT); const nodes: Text[] = []; let node;
        while (node = walker.nextNode()) nodes.push(node as Text);
        for (const text of nodes) { const value = text.data; const lower = value.toLowerCase(); let start = 0; let at = lower.indexOf(query); if (at < 0) continue; const fragment = document.createDocumentFragment(); while (at >= 0) { fragment.append(value.slice(start, at)); const mark = document.createElement('mark'); mark.textContent = value.slice(at, at + query.length); fragment.append(mark); count++; start = at + query.length; at = lower.indexOf(query, start); } fragment.append(value.slice(start)); text.replaceWith(fragment); }
      }
      document.querySelector('#transcript-count')!.textContent = query ? `${count} matches` : '';
    });
  </script>
</Shell>
