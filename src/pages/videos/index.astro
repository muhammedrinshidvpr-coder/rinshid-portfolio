---
import Shell from '../../layouts/Shell.astro';
import Entry from '../../components/Entry.astro';
import { catalog } from '../../lib/content';
import { site } from '../../config/site';
const { videos } = await catalog();
---
<Shell title="Videos" description="A home for educational videos, project demonstrations, and their transcripts.">
  <header class="page-head"><p class="eyebrow">Show, explain, explore</p><h1>In motion.</h1><p class="summary">A place for project walkthroughs and explanations—with written context and transcripts alongside them.</p></header>
  {videos.map((entry) => <Entry collection="videos" entry={entry} />)}
  {!videos.length && <div class="empty-note"><h2>No videos added here yet.</h2><p>I haven’t added any video entries to this notebook. You can find my channel on <a href={site.links.find((link) => link.platform === 'YouTube')!.url}>YouTube as Rinshid Razaq ↗</a>.</p></div>}
</Shell>
