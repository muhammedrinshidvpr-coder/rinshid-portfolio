---
import Shell from '../../layouts/Shell.astro';
import Entry from '../../components/Entry.astro';
import { catalog } from '../../lib/content';
import { site } from '../../config/site';
import { pathFor } from '../../lib/urls';
const { videos } = await catalog();
---
<Shell title="Videos" description="A home for educational videos, project demonstrations, and their transcripts.">
  <header class="page-head"><p class="eyebrow">Watch &amp; learn</p><h1>Videos.</h1><p class="summary">A home for project walkthroughs and student-friendly explanations, with transcripts alongside them.</p></header>
  {videos.map((entry) => <Entry collection="videos" entry={entry} headingLevel={2} />)}
  {!videos.length && <div class="empty-note"><h2>No videos added here yet.</h2><p>Visit <a href={site.links.find((link) => link.platform === 'YouTube')!.url}>my YouTube channel, Rinshid Razaq ↗</a>, or explore <a href={pathFor('/projects/')}>the projects</a>.</p></div>}
</Shell>
