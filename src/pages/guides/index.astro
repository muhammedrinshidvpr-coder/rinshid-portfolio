---
import Shell from '../../layouts/Shell.astro';
import Entry from '../../components/Entry.astro';
import { catalog } from '../../lib/content';
import { pathFor } from '../../lib/urls';
const guides = (await catalog()).writing.filter((entry) => entry.data.type === 'guide');
const groups = [...new Set(guides.map((entry) => entry.data.series?.name || entry.data.tags[0] || 'Getting started'))];
---
<Shell title="Student guides" description="Patient, practical explanations for fellow students, in English and Malayalam.">
  <header class="page-head"><p class="eyebrow">For fellow students</p><h1>Student guides.</h1><p class="summary">Practical explanations to help you understand a tool, try an idea, and build something with it.</p></header>
  {groups.map((group) => <section class="section"><h2>{group}</h2>{guides.filter((entry) => (entry.data.series?.name || entry.data.tags[0] || 'Getting started') === group).sort((a, b) => (a.data.series?.order || 0) - (b.data.series?.order || 0)).map((entry) => <Entry collection="writing" entry={entry} />)}</section>)}
  {!guides.length && <div class="empty-note"><h2>No guides published yet.</h2><p>Explore <a href={pathFor('/projects/')}>the projects</a> or <a href={pathFor('/contact/')}>send me a student question</a> you’d like explained.</p></div>}
</Shell>
